# Processed by the nginx image at container start: files in
# /etc/nginx/templates are run through envsubst into /etc/nginx/conf.d.
#
# The upstream host must NOT be hardcoded. The Helm chart prefixes every
# Service with the release name, so "game-server" becomes "pong-game-server"
# and nginx fails to start with "host not found in upstream".
#
# NGINX_ENVSUBST_FILTER limits substitution to GAME_SERVER_HOST, so nginx's own
# variables ($uri, $host, $http_upgrade) survive untouched.
server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;

  # The React app is a single-page app: any unknown path must still return
  # index.html so client-side routing works.
  location / {
    try_files $uri $uri/ /index.html;
  }

  # WebSocket upgrade to the game server. Without these three headers nginx
  # would treat /ws as an ordinary HTTP request and the upgrade would fail.
  location /ws {
    proxy_pass http://${GAME_SERVER_HOST}:3000;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_read_timeout 3600s;   # a match must not be cut off by an idle timeout
  }

  location ~ ^/(config|stats|health|ready|cluster|matches|leaderboard)$ {
    proxy_pass http://${GAME_SERVER_HOST}:3000;
    proxy_set_header Host $host;
  }

  location /auth/ {
    proxy_pass http://${GAME_SERVER_HOST}:3000;
    proxy_set_header Host $host;
  }
}
